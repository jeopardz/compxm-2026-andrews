# Copy this file to .streamlit/secrets.toml and fill in real values.
# secrets.toml is git-ignored; this .example is the committed template.
#
# LOCAL STUDY MODE: leave AUTH_ENABLED = false (or omit this file entirely).
# The app then runs exactly as the single-user study tool — no login, no DB,
# no database connection is made.

# Flip to true only for the multi-user SaaS deployment (Streamlit Cloud/production).
AUTH_ENABLED = false

# Supabase project (Project Settings -> API). Required only when AUTH_ENABLED = true.
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY = "YOUR-ANON-PUBLIC-KEY"

# Optional OAuth callback override. Usually omit this: the app detects its URL.
# Set it only when a proxy or custom domain hides the public URL from Streamlit.
# APP_URL = "https://your-app.example.com/"

# Lemon Squeezy hosted checkout URL for the $12.99 / 30-day product.
# The paywall appends ?checkout[custom][user_id]=... so the webhook can match the buyer.
LEMONSQUEEZY_CHECKOUT_URL = ""

# Required public contact for Privacy, Terms, billing and data requests.
SUPPORT_EMAIL = "support@compmastery.example"  # reserved placeholder; replace before launch

# Recommended production error monitoring. Leave blank in local study mode.
SENTRY_DSN = ""
SENTRY_ENVIRONMENT = "production"
SENTRY_TRACES_SAMPLE_RATE = "0.05"
LOG_LEVEL = "INFO"
